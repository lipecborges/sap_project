{
  "name": "@raiox/connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conector on-premise do Raio-X: conexão de saída (wss) até a API, que repassa as chamadas ao add-on SAP",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  },
  "files": [
    "dist"
  ]
}
