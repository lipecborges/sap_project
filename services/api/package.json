{
  "name": "@raiox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend Raio-X: mesma imagem para Cloud e Self-hosted",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.128.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@raiox/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.0",
    "postgres": "3.4.9",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@raiox/connector": "workspace:*",
    "@raiox/sap-mock": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "0.31.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
