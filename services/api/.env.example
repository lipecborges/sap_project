# Modo de implantação: selfhosted (SAP acessado direto) ou cloud (via conector)
DEPLOYMENT_MODE=selfhosted
# Endereço do SAP (ou do sap-mock em desenvolvimento)
SAP_BASE_URL=http://localhost:8000
# Mandante (opcional)
SAP_CLIENT=100
PORT=3000

# Assistente de IA
#   demo      = regras locais, sem modelo e sem internet (padrão)
#   anthropic = Claude, com os diagnósticos como ferramentas
AI_PROVIDER=demo
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
# AI_FALLBACKS=true   # desligue (false) se usar Claude via Bedrock/Vertex

# Cookie de sessão só por HTTPS (ligue em produção atrás de TLS)
# COOKIE_SECURE=true
# SESSION_IDLE_MINUTES=30
