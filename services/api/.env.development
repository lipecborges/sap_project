# Padrões do `pnpm dev`: API local apontando para o sap-mock. Sobrescreva em .env.
DEPLOYMENT_MODE=selfhosted
SAP_BASE_URL=http://localhost:8000
SAP_CLIENT=100
# Banco embutido em arquivo (sem Docker). Para PostgreSQL: DATABASE_URL=postgres://raiox:raiox@localhost:5432/raiox
DATABASE_URL=pglite:./.data/pglite
# Só para desenvolvimento. Em produção, gere com: openssl rand -base64 32
SESSION_SECRET=ZGV2LW9ubHktcmFpb3gtc2Vzc2lvbi1zZWNyZXQtMzJieXRlcw==
