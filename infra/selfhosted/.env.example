# Raio-X Self-hosted. Copie para .env (o install.sh faz isso e gera os segredos). Guia: docs/instalacao-selfhosted.md

# Endereço do SAP visto de dentro da VM (ex.: http://sap-prd.empresa.local:8000).
# Com o perfil "demo", use o simulador:
SAP_BASE_URL=http://sap-mock:8000
# Mandante SAP
SAP_CLIENT=100
LOG_LEVEL=info

# Porta publicada na VM (HTTP). Em produção, coloque um proxy HTTPS na frente.
# RAIOX_PORT=8080

# Segredos. O install.sh gera os dois quando estão vazios; não os troque depois de instalar
# (SESSION_SECRET novo derruba as sessões; POSTGRES_PASSWORD só vale na criação do volume do banco).
#   SESSION_SECRET:    openssl rand -base64 32   (cifra a senha SAP das sessões no banco)
#   POSTGRES_PASSWORD: openssl rand -hex 24      (use só letras e números: ela entra numa URL)
SESSION_SECRET=
POSTGRES_PASSWORD=

# Perfis do Compose ativados por padrão: "demo" sobe o simulador SAP (sap-mock).
# COMPOSE_PROFILES=demo

# Assistente de IA: "demo" funciona sem internet; "anthropic" precisa de saída para a API da Anthropic
AI_PROVIDER=demo
# ANTHROPIC_API_KEY=sk-ant-...

# Atrás de um proxy HTTPS (recomendado em produção): cookie só por HTTPS e cabeçalho HSTS
# COOKIE_SECURE=true

# Proxy reverso à frente da API: confia no X-Forwarded-For para o IP real (limites, logs, auditoria).
# Padrão true. Use false se a porta da API for exposta direto a clientes (o cabeçalho poderia ser forjado).
# TRUST_PROXY=true

# Limite de requisições por IP (memória do processo; vale por réplica).
# Global, generoso: a interface faz várias chamadas por tela.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_SECONDS=60
# Estrito, para POST /api/v1/auth/login e /auth/check (por IP + usuário): freia força bruta.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Métricas Prometheus em GET /metrics (Authorization: Bearer <token>). Sem token, o endpoint fica desligado (404).
# Gere com: openssl rand -hex 24
# METRICS_TOKEN=

# Backups (backup.sh): quantos dias manter em ./backups
# BACKUP_RETENTION_DAYS=14
