# Endereço do SAP visto de dentro da VM (ex.: http://sap-prd.empresa.local:8000).
# Com o perfil "demo", use o simulador:
SAP_BASE_URL=http://sap-mock:8000
# Mandante SAP
SAP_CLIENT=100
LOG_LEVEL=info

# Assistente de IA: "demo" funciona sem internet; "anthropic" precisa de saída para a API da Anthropic
AI_PROVIDER=demo
# ANTHROPIC_API_KEY=sk-ant-...

# Atrás de um proxy HTTPS (recomendado em produção):
# COOKIE_SECURE=true
